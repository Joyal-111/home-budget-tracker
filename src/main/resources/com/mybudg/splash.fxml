<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" styleClass="splash-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mybudg.SplashController">
    <children>
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Custom Title Bar for Dragging and Window Controls -->
                <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="35.0" spacing="10.0" styleClass="title-bar-light">
                    <children>
                        <Button mnemonicParsing="false" onAction="#minimizeWindow" styleClass="window-btn-light" text="—" />
                        <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="window-btn-light, close-btn-light" text="✕" />
                    </children>
                    <padding>
                        <Insets right="10.0" />
                    </padding>
                </HBox>

                <VBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Logo area -->
                        <VBox fx:id="logoContainer" alignment="CENTER" spacing="10.0">
                            <children>
                                <javafx.scene.image.ImageView fx:id="logoImage" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" styleClass="splash-logo">
                                    <image>
                                        <javafx.scene.image.Image url="@logo.png" />
                                    </image>
                                </javafx.scene.image.ImageView>
                                <Label styleClass="auth-title" text="MyBudg" />
                            </children>
                        </VBox>
                        
                        <VBox alignment="CENTER" maxWidth="400.0" spacing="15.0">
                            <children>
                                <ProgressBar fx:id="progressBar" prefHeight="8.0" prefWidth="400.0" progress="0.0" styleClass="splash-progress" />
                                <Label fx:id="statusLabel" text="Initializing budget modules..." textFill="WHITE">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
