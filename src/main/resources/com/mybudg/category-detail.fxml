<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" styleClass="analysis-page-root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mybudg.CategoryDetailController">
    <children>
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Custom Title Bar -->
                <HBox fx:id="titleBar" alignment="CENTER_RIGHT" prefHeight="35.0" spacing="10.0" styleClass="title-bar-light">
                    <children>
                        <Button mnemonicParsing="false" onAction="#minimizeWindow" styleClass="window-btn-light" text="—" />
                        <Button mnemonicParsing="false" onAction="#closeWindow" styleClass="window-btn-light, close-btn-light" text="✕" />
                    </children>
                    <padding>
                        <Insets right="10.0" />
                    </padding>
                </HBox>

                <VBox spacing="25.0" styleClass="analysis-container" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
                    </padding>
                    <children>
                        <!-- Header Section -->
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <children>
                                <Button onAction="#handleBack" styleClass="back-button-styled" text="← Back to Dashboard" />
                                <Label fx:id="pageTitle" styleClass="analysis-title" text="Category Distribution" />
                            </children>
                        </HBox>

                        <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Pie Chart Section -->
                                <VBox fx:id="chartContainer" spacing="15.0" styleClass="chart-card-styled" HBox.hgrow="ALWAYS">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label styleClass="chart-header-label" text="Visual Representation" />
                                        <PieChart fx:id="categoryPieChart" prefHeight="500.0" legendSide="BOTTOM" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>

                                <!-- Table Section -->
                                <VBox fx:id="tableContainer" spacing="15.0" styleClass="chart-card-styled" prefWidth="480.0">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label styleClass="chart-header-label" text="Summary Table" />
                                        <TableView fx:id="categoryTable" prefHeight="450.0" styleClass="modern-table" style="-fx-font-size: 16px;">
                                            <columns>
                                                <TableColumn fx:id="categoryColumn" prefWidth="280.0" text="Category" />
                                                <TableColumn fx:id="amountColumn" prefWidth="160.0" text="Total Amount" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
